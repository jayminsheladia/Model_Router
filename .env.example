# Copy this file to .env and fill in the keys you want to enable.
# Without either, the router falls back to the heuristic classifier and the
# simulated mock model backend -- everything still works, just not "live."

# Enables the real LLM classification fallback for genuinely ambiguous
# prompts (app/llm_classifier.py).
ANTHROPIC_API_KEY=

# Enables real model serving (app/models/groq_client.py) instead of the
# simulated mock backend -- cheap/mid/frontier tiers map to real Groq-hosted
# models with real cost and latency. Get a key at console.groq.com.
GROQ_API_KEY=
